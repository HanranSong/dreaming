# Copy to .env in this folder. Values already set in the environment take priority.
ANTHROPIC_API_KEY=

# Leave a model empty to use claude-haiku-5-5, the official cookbook's default.
DREAMING_ANALYZER_MODEL=
DREAMING_ORGANIZER_MODEL=

# low, medium, high, xhigh or max. Leave empty to use the API's default.
DREAMING_ANALYZER_EFFORT=
DREAMING_ORGANIZER_EFFORT=
