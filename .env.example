# Copy to .env in this folder. Values already set in the environment take priority.
ANTHROPIC_API_KEY=

# Leave a model empty to use claude-haiku-5-5, the official cookbook's default.
DREAMING_ANALYZER_MODEL=
DREAMING_ORGANIZER_MODEL=

# low, medium, high, xhigh or max. Leave empty to use the API's default.
DREAMING_ANALYZER_EFFORT=
DREAMING_ORGANIZER_EFFORT=

# The most lines one file read returns, whatever limit the agent asks for. A longer transcript is split into
# parts of this size. Leave empty for 25000, which at about 32 tokens a line fits a 1M-token context.
# Lower it for a model with a smaller one. The minimum is 100.
DREAMING_READ_LIMIT=

# Set to true and add a key to trace agent runs in LangSmith. Traces hold the full transcripts and memory text.
# Do not also set LANGSMITH_PROJECT: with both a project and an agent ID in the environment, nothing is traced.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=dreaming
LANGSMITH_AGENT_ENVIRONMENT=local
